{% extends "layout.html.twig" %}

{% block title %}Mentions Légales | StagePro{% endblock %}

{% block content %}
<section>
    <h1 style="color: var(--accent-blue); margin-bottom: 1rem;">Mentions légales</h1>
    <p style="color: var(--text-muted); border-left: 3px solid var(--accent-purple); font-style: italic;">
        Conformément aux dispositions des articles 6-III et 19 de la Loi n° 2004-575 du 21 juin 2004 pour la Confiance dans l'Économie Numérique (L.C.E.N.).
    </p>
</section>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 3rem;">
    
    <section style="background: var(--surface); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border);">
        <h2 style="font-size: 1.2rem; margin-bottom: 1rem; color: var(--accent-purple);">Éditeur du site</h2>
        <p style="font-size: 0.9rem; line-height: 1.6;">
            <strong>StagePro</strong> est réalisé dans le cadre d’un projet pédagogique.
        </p>
        <ul style="list-style: none; padding: 0; margin-top: 1rem; font-size: 0.85rem; color: var(--text-muted); line-height: 1.8;">
            <li>• <strong>Nom de l’entreprise :</strong> Stage Pro</li>
            <li>• <strong>Forme juridique :</strong> SAS</li>
            <li>• <strong>SIRET :</strong> 342 707 502 00759</li>
            <li>• <strong>Capital social :</strong> 100 000 000 €</li>
            <li>• <strong>Siège social :</strong> 390 rue Claude Nicolas Ledoux, 13290 Aix-en-Provence</li>
            <li>• <strong>Directrice de publication :</strong> Melissa Moegen</li>
            <li>• <strong>Contact :</strong> melissa.moegen@viacesi.fr</li>
        </ul>
    </section>

    <section style="background: var(--surface); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border);">
        <h2 style="font-size: 1.2rem; margin-bottom: 1rem; color: var(--accent-purple);">Hébergement</h2>
        <p style="font-size: 0.9rem; line-height: 1.6;">
            Site hébergé en environnement local dans le cadre de soutenance académique.
        </p>
        <ul style="list-style: none; padding: 0; margin-top: 1rem; font-size: 0.85rem; color: var(--text-muted); line-height: 1.8;">
            <li>• <strong>Hébergeur :</strong> XAMPP / Apache local</li>
            <li>• <strong>Adresse :</strong> 390 rue Claude Nicolas Ledoux, 13290 Aix-en-Provence </li>
            <li>• <strong>URL locale :</strong> https://stagepro.fr</li>
            <li>• <strong>Finalité :</strong> Soutenance académique</li>
        </ul>
    </section>

</div>

<section style="margin-top: 3rem;">
    <h2 style="margin-bottom: 1rem;">Données personnelles (<a href="https://www.cnil.fr/fr/reglement-europeen-protection-donnees"
   target="_blank"
   rel="noopener noreferrer"
   style="color: #2563eb; text-decoration: underline;">RGPD</a>)</h2>
    <div style="background: rgba(129, 140, 248, 0.05); padding: 2rem; border-radius: 8px; border: 1px dashed var(--border);">
        <p style="margin-bottom: 1rem;">
            Les données collectées dans le cadre de l’utilisation du site <strong>StagePro</strong> peuvent inclure le nom, le prénom, l’adresse email, les candidatures, les CV transmis et les informations liées aux comptes utilisateurs.
        </p>
        <p style="font-size: 0.9rem; color: var(--text-muted);">
            Ces données sont utilisées uniquement dans le cadre du projet pédagogique et de la démonstration de la plateforme. Conformément au <a href="https://www.cnil.fr/fr/reglement-europeen-protection-donnees"
   target="_blank"
   rel="noopener noreferrer"
   style="color: var(--accent-blue); text-decoration: underline; font-weight: 600;">
   RGPD</a>, vous disposez d'un droit d'accès, de rectification et de suppression de vos données en contactant : <strong>melissa.moegen@viacesi.fr</strong>.
        </p>
        <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 1rem;">
            Aucune donnée personnelle n’est revendue ou transférée à des tiers.
        </p>
    </div>
</section>

<section style="margin-top: 3rem;">
    <h2 style="margin-bottom: 1rem;">Cookies</h2>
    <div style="background: #ffffff; padding: 2rem; border-radius: 8px; border: 1px solid var(--border);">
        <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6;">
            Le site utilise des cookies nécessaires au bon fonctionnement de la session utilisateur ainsi que des cookies statistiques lorsque l’utilisateur les accepte. L’utilisateur peut modifier ses préférences depuis le lien prévu à cet effet en bas de page.
        </p>
    </div>
</section>

<section style="margin-top: 3rem; margin-bottom: 3rem;">
    <h2 style="margin-bottom: 1rem;">Propriété intellectuelle</h2>
    <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.6;">
        Tous les éléments présents sur le site <strong>StagePro</strong>, notamment les textes, logos, éléments graphiques, interfaces et code source, sont protégés par le droit de la propriété intellectuelle. Toute reproduction, représentation, modification ou diffusion sans autorisation préalable est interdite, sauf dans le cadre strict de l’évaluation pédagogique.
    </p>
</section>

<div style="text-align: center; margin-bottom: 5rem;">
    <a href="/home" class="btn-cta" style="background: transparent; border: 1px solid var(--accent-blue); color: var(--accent-blue); text-decoration: none; padding: 0.8rem 1.5rem; border-radius: 6px; font-weight: 600;">
        &larr; Retour à l'accueil
    </a>
</div>
{% endblock %}